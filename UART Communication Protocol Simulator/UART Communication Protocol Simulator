#include <stdio.h>
#include <string.h>

#define START_BYTE 0xAA

typedef struct
{
    unsigned char start;
    unsigned char device_id;
    unsigned char data;
    unsigned char checksum;
} UART_Frame;
/* Calculate checksum */
unsigned char calculate_checksum(unsigned char device_id,
                                 unsigned char data)
{
    return device_id ^ data;
}

/* Create UART frame */
UART_Frame create_frame(unsigned char device_id,
                        unsigned char data)
{
    UART_Frame frame;

    frame.start = START_BYTE;
    frame.device_id = device_id;
    frame.data = data;
    frame.checksum = calculate_checksum(device_id, data);

    return frame;
}
* Display transmitted frame */
void transmit_frame(UART_Frame frame)
{

    printf("START     : 0x%02X\n", frame.start);
    printf("DEVICE ID : 0x%02X\n", frame.device_id);
    printf("DATA      : 0x%02X\n", frame.data);
    printf("CHECKSUM  : 0x%02X\n", frame.checksum);
}
/* Receive and verify frame */
void receive_frame(UART_Frame frame)
{
    unsigned char checksum;

    printf("\n--- UART RECEPTION ---\n");

    checksum = calculate_checksum(frame.device_id,
                                  frame.data);

    printf("Received DATA: %d\n", frame.data);

    if (checksum == frame.checksum)
    {
        printf("CHECKSUM: VALID\n");
        printf("STATUS: DATA RECEIVED SUCCESSFULLY\n");
    }
    else
    {
        printf("CHECKSUM: ERROR\n");
        printf("STATUS: DATA CORRUPTED\n");
    }
}

int main()
{
    UART_Frame frame;

    unsigned char device_id;
    unsigned char data;
    printf("     UART COMMUNICATION SIMULATOR\n");

    printf("\nEnter Device ID (0-255): ");
    scanf("%hhu", &device_id);

    printf("Enter Sensor Data (0-255): ");
    scanf("%hhu", &data);

    /* Create UART packet */
    frame = create_frame(device_id, data);

    /* Transmit */
    transmit_frame(frame);

    /* Receive */
    receive_frame(frame);

    return 0;
}